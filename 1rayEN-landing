<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1RAY – Mayan Oracle | Unlock the Code of Your Soul</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #0B0C10;
            --bg-teal: #0A0F14;
            --magenta: #FF00FF;
            --cyan: #00FFFF;
            --gold: #FFD700;
            --jade: #00FF88;
            --purple: #7B2FFF;
            --white: #FFFFFF;
            --gray: #B0B0B0;
            --card-bg: rgba(11, 12, 16, 0.75);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glow-magenta: 0 0 20px rgba(255, 0, 255, 0.6), 0 0 60px rgba(255, 0, 255, 0.3), 0 0 100px rgba(255, 0, 255, 0.15);
            --glow-cyan: 0 0 20px rgba(0, 255, 255, 0.6), 0 0 60px rgba(0, 255, 255, 0.3), 0 0 100px rgba(0, 255, 255, 0.15);
            --glow-gold: 0 0 20px rgba(255, 215, 0, 0.6), 0 0 60px rgba(255, 215, 0, 0.3), 0 0 100px rgba(255, 215, 0, 0.15);
            --glow-jade: 0 0 20px rgba(0, 255, 136, 0.5), 0 0 50px rgba(0, 255, 136, 0.25);
            --glow-purple: 0 0 20px rgba(123, 47, 255, 0.5), 0 0 50px rgba(123, 47, 255, 0.25);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-deep);
            color: var(--white);
            font-family: 'Inter', 'Space Grotesk', sans-serif;
            line-height: 1.6;
            overflow-x: hidden;
            min-height: 100vh;
            position: relative;
        }

        /* Background grid overlay */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            background:
                linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7) 30%, rgba(0, 0, 0, 0) 70%);
            -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7) 30%, rgba(0, 0, 0, 0) 70%);
        }

        /* Mayan geometric pattern overlay */
        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.04;
            background:
                repeating-linear-gradient(45deg, transparent, transparent 60px, rgba(123, 47, 255, 0.3) 60px, rgba(123, 47, 255, 0.3) 61px),
                repeating-linear-gradient(-45deg, transparent, transparent 60px, rgba(255, 0, 255, 0.3) 60px, rgba(255, 0, 255, 0.3) 61px);
            background-size: 120px 120px;
            mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.5) 20%, rgba(0, 0, 0, 0) 65%);
            -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.5) 20%, rgba(0, 0, 0, 0) 65%);
        }

        /* Particle canvas */
        #particles-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
            position: relative;
            z-index: 2;
        }

        /* Typography */
        h1,
        h2,
        h3,
        .font-display {
            font-family: 'Orbitron', 'Rajdhani', sans-serif;
            font-weight: 700;
            letter-spacing: 0.03em;
        }

        h1 {
            font-size: clamp(2.4rem, 5vw, 4rem);
            line-height: 1.15;
        }
        h2 {
            font-size: clamp(1.8rem, 3.5vw, 2.8rem);
        }
        h3 {
            font-size: clamp(1.2rem, 2vw, 1.6rem);
        }

        .text-gray {
            color: var(--gray);
        }
        .text-cyan {
            color: var(--cyan);
        }
        .text-magenta {
            color: var(--magenta);
        }
        .text-gold {
            color: var(--gold);
        }
        .text-jade {
            color: var(--jade);
        }
        .text-purple {
            color: var(--purple);
        }

        /* Neon glow text */
        .neon-cyan {
            color: var(--cyan);
            text-shadow: 0 0 10px rgba(0, 255, 255, 0.8), 0 0 30px rgba(0, 255, 255, 0.4), 0 0 60px rgba(0, 255, 255, 0.2);
        }
        .neon-magenta {
            color: var(--magenta);
            text-shadow: 0 0 10px rgba(255, 0, 255, 0.8), 0 0 30px rgba(255, 0, 255, 0.4), 0 0 60px rgba(255, 0, 255, 0.2);
        }
        .neon-gold {
            color: var(--gold);
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.8), 0 0 30px rgba(255, 215, 0, 0.4), 0 0 60px rgba(255, 215, 0, 0.2);
        }

        /* Glass card */
        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            position: relative;
            overflow: hidden;
        }
        .glass-card:hover {
            border-color: rgba(0, 255, 255, 0.4);
            box-shadow: var(--glow-cyan);
            transform: translateY(-4px);
        }
        .glass-card.magenta-hover:hover {
            border-color: rgba(255, 0, 255, 0.4);
            box-shadow: var(--glow-magenta);
        }
        .glass-card.gold-hover:hover {
            border-color: rgba(255, 215, 0, 0.4);
            box-shadow: var(--glow-gold);
        }

        /* Glitch hover effect */
        .glitch-hover {
            position: relative;
            transition: all 0.3s ease;
        }
        .glitch-hover:hover {
            animation: glitch-skew 0.4s ease-in-out;
        }
        @keyframes glitch-skew {
            0%,
            100% {
                transform: translate(0);
            }
            20% {
                transform: translate(-3px, 2px);
            }
            40% {
                transform: translate(3px, -2px);
            }
            60% {
                transform: translate(-2px, -1px);
            }
            80% {
                transform: translate(2px, 1px);
            }
        }
        @keyframes glitch-clip {
            0%,
            100% {
                clip-path: inset(0 0 0 0);
            }
            25% {
                clip-path: inset(20% 0 60% 0);
            }
            50% {
                clip-path: inset(50% 0 30% 0);
            }
            75% {
                clip-path: inset(10% 0 70% 0);
            }
        }

        /* Buttons */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 16px 36px;
            background: linear-gradient(135deg, rgba(255, 0, 255, 0.2), rgba(123, 47, 255, 0.2));
            border: 2px solid var(--magenta);
            border-radius: 50px;
            color: var(--white);
            font-family: 'Orbitron', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 0.05em;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.35s ease;
            position: relative;
            overflow: hidden;
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 25px rgba(255, 0, 255, 0.35), 0 0 50px rgba(255, 0, 255, 0.15), inset 0 0 20px rgba(255, 0, 255, 0.1);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, rgba(255, 0, 255, 0.35), rgba(123, 47, 255, 0.35));
            border-color: var(--cyan);
            box-shadow: 0 0 40px rgba(0, 255, 255, 0.5), 0 0 80px rgba(0, 255, 255, 0.25), 0 0 120px rgba(255, 0, 255, 0.2);
            transform: translateY(-3px);
            color: #fff;
        }
        .btn-primary::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 60%);
            opacity: 0;
            transition: opacity 0.4s;
        }
        .btn-primary:hover::after {
            opacity: 1;
            animation: shimmer 1.2s ease-out;
        }
        @keyframes shimmer {
            0% {
                transform: scale(0);
                opacity: 1;
            }
            100% {
                transform: scale(1.5);
                opacity: 0;
            }
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            background: transparent;
            border: 1.5px solid var(--cyan);
            border-radius: 50px;
            color: var(--cyan);
            font-family: 'Orbitron', sans-serif;
            font-weight: 500;
            font-size: 0.9rem;
            letter-spacing: 0.04em;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.35s ease;
            text-shadow: 0 0 6px rgba(0, 255, 255, 0.4);
        }
        .btn-secondary:hover {
            background: rgba(0, 255, 255, 0.1);
            box-shadow: var(--glow-cyan);
            border-color: #fff;
            color: #fff;
            transform: translateY(-2px);
        }

        /* Section dividers */
        .section-divider {
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--magenta), var(--cyan), var(--purple), transparent);
            margin: 60px 0;
            position: relative;
            border-radius: 50%;
            filter: blur(1px);
        }
        .section-divider::after {
            content: '';
            position: absolute;
            top: -4px;
            left: 50%;
            transform: translateX(-50%);
            width: 40px;
            height: 10px;
            background: var(--gold);
            border-radius: 50%;
            box-shadow: var(--glow-gold);
            filter: blur(3px);
        }

        /* Mayan fret divider */
        .mayan-divider {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin: 40px 0;
            opacity: 0.7;
        }
        .mayan-divider span {
            display: block;
            width: 28px;
            height: 28px;
            border: 1.5px solid var(--cyan);
            transform: rotate(45deg);
            box-shadow: 0 0 8px rgba(0, 255, 255, 0.3);
        }
        .mayan-divider span:nth-child(odd) {
            border-color: var(--magenta);
            box-shadow: 0 0 8px rgba(255, 0, 255, 0.3);
        }
        .mayan-divider span:nth-child(3) {
            border-color: var(--gold);
            box-shadow: 0 0 8px rgba(255, 215, 0, 0.4);
            width: 34px;
            height: 34px;
        }

        /* Hero section */
        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 80px 0 60px;
            position: relative;
        }
        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
            width: 100%;
        }
        .hero-content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .hero-content h1 {
            background: linear-gradient(180deg, #fff 0%, #e0e0ff 40%, var(--cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 0 20px rgba(0, 255, 255, 0.5));
        }
        .hero-subtitle {
            font-size: clamp(1rem, 1.8vw, 1.25rem);
            color: var(--gray);
            max-width: 500px;
            line-height: 1.7;
        }
        .hero-cta-group {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-top: 12px;
        }

        /* Tzolkin Wheel */
        .tzolkin-container {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }
        .tzolkin-wheel {
            width: clamp(260px, 38vw, 420px);
            height: clamp(260px, 38vw, 420px);
            animation: rotate-wheel 30s linear infinite;
            filter: drop-shadow(0 0 30px rgba(0, 255, 255, 0.5)) drop-shadow(0 0 60px rgba(255, 0, 255, 0.3));
            position: relative;
            z-index: 2;
        }
        @keyframes rotate-wheel {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }
        .tzolkin-wheel svg {
            width: 100%;
            height: 100%;
        }
        .tzolkin-glow-pulse {
            position: absolute;
            width: 110%;
            height: 110%;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.15) 0%, rgba(255, 0, 255, 0.08) 30%, transparent 60%);
            animation: pulse-glow 3s ease-in-out infinite;
            pointer-events: none;
            z-index: 1;
        }
        @keyframes pulse-glow {
            0%,
            100% {
                transform: scale(1);
                opacity: 0.6;
            }
            50% {
                transform: scale(1.15);
                opacity: 1;
            }
        }
        .floating-particles-ring {
            position: absolute;
            width: 130%;
            height: 130%;
            border-radius: 50%;
            border: 1px dashed rgba(255, 215, 0, 0.2);
            animation: rotate-wheel 45s linear infinite reverse;
            pointer-events: none;
            z-index: 0;
        }
        .floating-particles-ring::before,
        .floating-particles-ring::after {
            content: '';
            position: absolute;
            width: 8px;
            height: 8px;
            background: var(--gold);
            border-radius: 50%;
            box-shadow: var(--glow-gold);
        }
        .floating-particles-ring::before {
            top: -4px;
            left: 50%;
        }
        .floating-particles-ring::after {
            bottom: -4px;
            left: 50%;
            background: var(--cyan);
            box-shadow: var(--glow-cyan);
        }

        /* Feature cards */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 40px;
        }
        .feature-card {
            padding: 32px 24px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            cursor: default;
        }
        .feature-icon {
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            border-radius: 50%;
            position: relative;
            transition: all 0.5s ease;
        }
        .feature-card:hover .feature-icon {
            transform: scale(1.15);
        }
        .feature-icon.sun-icon {
            background: radial-gradient(circle, rgba(255, 215, 0, 0.25), transparent);
            box-shadow: var(--glow-gold);
        }
        .feature-icon.rings-icon {
            background: radial-gradient(circle, rgba(0, 255, 255, 0.25), transparent);
            box-shadow: var(--glow-cyan);
        }
        .feature-icon.eye-icon {
            background: radial-gradient(circle, rgba(255, 0, 255, 0.25), transparent);
            box-shadow: var(--glow-magenta);
        }
        .feature-card h3 {
            font-size: 1.2rem;
            letter-spacing: 0.04em;
        }
        .feature-card p {
            color: var(--gray);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* How it works */
        .steps-container {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-top: 40px;
            position: relative;
            flex-wrap: wrap;
        }
        .steps-container::before {
            content: '';
            position: absolute;
            top: 60px;
            left: 10%;
            width: 80%;
            height: 2px;
            background: repeating-linear-gradient(90deg, var(--cyan) 0, var(--cyan) 8px, transparent 8px, transparent 16px);
            opacity: 0.5;
            z-index: 0;
        }
        .step-item {
            flex: 1;
            min-width: 200px;
            text-align: center;
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }
        .step-number {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            font-weight: 900;
            position: relative;
            background: var(--card-bg);
            border: 2px solid var(--cyan);
            box-shadow: var(--glow-cyan);
            color: var(--cyan);
            text-shadow: 0 0 15px rgba(0, 255, 255, 0.7);
        }
        .step-item:nth-child(2) .step-number {
            border-color: var(--magenta);
            box-shadow: var(--glow-magenta);
            color: var(--magenta);
            text-shadow: 0 0 15px rgba(255, 0, 255, 0.7);
        }
        .step-item:nth-child(3) .step-number {
            border-color: var(--gold);
            box-shadow: var(--glow-gold);
            color: var(--gold);
            text-shadow: 0 0 15px rgba(255, 215, 0, 0.7);
        }
        .step-image-placeholder {
            width: 100%;
            max-width: 200px;
            height: 140px;
            border-radius: 12px;
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            opacity: 0.8;
            transition: all 0.4s ease;
        }
        .step-item:hover .step-image-placeholder {
            border-color: rgba(0, 255, 255, 0.5);
            box-shadow: var(--glow-cyan);
            opacity: 1;
        }
        .step-label {
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 0.03em;
        }
        .step-desc {
            color: var(--gray);
            font-size: 0.85rem;
            max-width: 200px;
        }

        /* Pricing */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 40px;
        }
        .pricing-card {
            padding: 32px 24px;
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 16px;
            position: relative;
        }
        .pricing-card.recommended {
            border-color: var(--gold) !important;
            box-shadow: var(--glow-gold) !important;
            transform: scale(1.04);
            z-index: 3;
        }
        .pricing-card.recommended::before {
            content: 'RECOMMENDED';
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--gold);
            color: #000;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 5px 18px;
            border-radius: 20px;
            letter-spacing: 0.06em;
            box-shadow: var(--glow-gold);
        }
        .pricing-card .price {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            font-weight: 900;
            color: var(--gold);
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.7);
            letter-spacing: 0.02em;
        }
        .pricing-card .price small {
            font-size: 0.9rem;
            font-weight: 400;
            color: var(--gray);
        }
        .pricing-card ul {
            list-style: none;
            padding: 0;
            text-align: left;
        }
        .pricing-card ul li {
            padding: 6px 0;
            color: var(--gray);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .pricing-card ul li::before {
            content: '◆';
            color: var(--jade);
            font-size: 0.6rem;
            text-shadow: 0 0 6px rgba(0, 255, 136, 0.6);
        }

        /* Testimonials */
        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 40px;
        }
        .testimonial-card {
            padding: 28px 22px;
            position: relative;
        }
        .testimonial-card .quote-mark {
            font-family: 'Orbitron', serif;
            font-size: 3rem;
            line-height: 1;
            color: var(--magenta);
            text-shadow: 0 0 12px rgba(255, 0, 255, 0.5);
            opacity: 0.7;
            margin-bottom: -10px;
        }
        .testimonial-card p {
            color: var(--gray);
            font-style: italic;
            font-size: 0.9rem;
            line-height: 1.6;
        }
        .testimonial-card .author {
            color: var(--cyan);
            font-weight: 600;
            font-size: 0.85rem;
            margin-top: 8px;
            letter-spacing: 0.03em;
        }

        /* Footer */
        .site-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding: 40px 0 30px;
            margin-top: 60px;
            text-align: center;
        }
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }
        .footer-links a {
            color: var(--gray);
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.3s;
            letter-spacing: 0.03em;
        }
        .footer-links a:hover {
            color: var(--cyan);
            text-shadow: 0 0 8px rgba(0, 255, 255, 0.5);
        }
        .footer-logo {
            display: inline-block;
            width: 36px;
            height: 36px;
            margin-bottom: 12px;
            opacity: 0.7;
            animation: rotate-wheel 20s linear infinite;
        }
        .footer-copy {
            color: var(--gray);
            font-size: 0.8rem;
            opacity: 0.6;
        }

        /* Mobile responsive */
        @media (max-width: 968px) {
            .hero-grid {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .hero-content {
                align-items: center;
                order: 2;
            }
            .tzolkin-container {
                order: 1;
                margin-bottom: 20px;
            }
            .tzolkin-wheel {
                width: 200px;
                height: 200px;
            }
            .hero-subtitle {
                max-width: 100%;
            }
            .hero-cta-group {
                justify-content: center;
            }
            .features-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .pricing-grid {
